# ============================================================
# Ansar GRANTS project env — copy to deploy/grants/.env on the VPS and fill in.
# NEVER commit the real .env (it is git-ignored). Only this .example is committed.
# Location on server: /opt/ansar/grants/.env
# ============================================================

# ── VPS (informational; no domain yet) ───────────────────────
VPS_IP=31.210.174.74

# ── Database (points at the SHARED Postgres on ansar_shared) ─
# Host is `db` (the shared container). DB/USER/PASSWORD MUST match the GRANTS_*
# values in deploy/shared/.env. N8N_DB_* must match the n8n DB role there too.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=grants_db
POSTGRES_USER=grants_user
POSTGRES_PASSWORD=CHANGE_ME_match_shared_GRANTS_DB_PASSWORD
N8N_DB_USER=n8n_user
N8N_DB_PASSWORD=CHANGE_ME_match_shared_N8N_DB_PASSWORD

# ── Redis (shared) ───────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── FastAPI / JWT ────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_random_64_char_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Admin seed user ──────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_admin_password

# ── Telegram Bot ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=CHANGE_ME_botfather_token
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USERS=CHANGE_ME_comma_separated_telegram_user_ids
# Shared secret for GET /deadlines/reminders. When set, the n8n cron MUST send
# header X-Reminder-Secret with this value.
REMINDER_CRON_SECRET=CHANGE_ME_random_reminder_secret

# ── NVIDIA NIM (LLM + embeddings) ────────────────────────────
NVIDIA_API_KEY=CHANGE_ME_nvapi_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=qwen/qwen3-coder-480b-a35b-instruct
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
# Optional dedicated embedding key; falls back to NVIDIA_API_KEY when empty.
NVIDIA_EMBEDDING_API_KEY=

# ── NVIDIA NIM — StepFun multimodal (Phase 3 OCR) ────────────
# Optional dedicated key; falls back to NVIDIA_API_KEY when empty.
NVIDIA_STEP_API_KEY=
NVIDIA_STEP_MODEL=stepfun-ai/step-3.7-flash
NVIDIA_STEP_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Email / SMTP (Phase 4 — optional second reminder channel) ─
# Leave SMTP_HOST empty to disable email entirely (Telegram-only reminders).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM=

# ── Backend URL (used by bot) ────────────────────────────────
BACKEND_URL=http://backend:8000

# ── CORS ─────────────────────────────────────────────────────
# Add the public origin once a domain/frontend exists. For IP/HTTP now, include
# the VPS IP origin if a browser frontend will call the API directly.
CORS_ORIGINS=http://localhost:3000,http://31.210.174.74

# ── n8n basic-auth (n8n's own login; Caddy basic-auth is separate) ──
N8N_USER=admin
N8N_PASSWORD=CHANGE_ME_n8n_password
# Losing this key makes stored n8n credentials unrecoverable. Back up the
# n8n_data volume together with Postgres backups.
N8N_ENCRYPTION_KEY=CHANGE_ME_random_n8n_encryption_key
# Public host / URL for n8n (set when a domain exists, else IP).
N8N_HOST=31.210.174.74
N8N_PUBLIC_URL=http://31.210.174.74/n8n/

# ── Optional extra API keys (used by some scrapers; safe to leave empty) ──
OPENAI_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
