# ============================================================
# Ansar SHARED stack env — copy to deploy/shared/.env on the VPS and fill in.
# NEVER commit the real .env. Only this .example file is committed.
# Location on server: /opt/ansar/shared/.env
# ============================================================

# ── Postgres bootstrap superuser (the shared instance) ───────
# This is the admin role for the whole Postgres instance. Per-project DBs/roles
# (e.g. grants) are created from the GRANTS_* vars below on first boot.
POSTGRES_DB=postgres
POSTGRES_USER=ansar_admin
POSTGRES_PASSWORD=CHANGE_ME_strong_superuser_password

# ── Grants project database + dedicated least-privilege role ─
# These must match deploy/grants/.env (POSTGRES_DB / POSTGRES_USER /
# POSTGRES_PASSWORD there point at THESE values). n8n uses the same grants_db
# database but authenticates with its own N8N_DB_* role for the n8n schema.
GRANTS_DB=grants_db
GRANTS_DB_USER=grants_user
GRANTS_DB_PASSWORD=CHANGE_ME_strong_grants_db_password
N8N_DB_USER=n8n_user
N8N_DB_PASSWORD=CHANGE_ME_strong_n8n_db_password

# ── Caddy / TLS ──────────────────────────────────────────────
# Used only once a domain TLS block is enabled in the Caddyfile.
ACME_EMAIL=you@example.com

# ── n8n basic-auth (enforced by Caddy, NOT a raw published port) ─
# N8N_BASICAUTH_HASH is a BCRYPT hash, not the plaintext. Generate with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-strong-pass'
# The bcrypt hash contains "$" characters and MUST be single-quoted in the real
# .env so compose does not interpolate it, e.g. N8N_BASICAUTH_HASH='$2a$...'
N8N_BASICAUTH_USER=admin
N8N_BASICAUTH_HASH=CHANGE_ME_bcrypt_hash_from_caddy_hash_password
