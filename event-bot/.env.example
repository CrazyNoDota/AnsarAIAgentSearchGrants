# Telegram bot token from @BotFather (NEW bot, separate from grants bot)
TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram user IDs allowed to use the bot.
# Get yours from @userinfobot. Empty = nobody can use it.
TELEGRAM_ALLOWED_USERS=

# LLM for mapping unknown form fields to profile keys.
# Reuse the same NVIDIA Qwen3 endpoint as the grants project.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=qwen/qwen3-coder-480b-a35b-instruct

# Optional OpenAI fallback if NVIDIA is unavailable
OPENAI_API_KEY=

# SQLite database file (mounted volume on Oracle VM)
DATABASE_PATH=/data/event_bot.db

# Where Playwright stores downloaded browser binaries
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Headless = true for production, false for local debugging
HEADLESS=true
