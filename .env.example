# ============================================================
# AI Grant Discovery & Recommendation System
# Copy this to .env and fill in your values
# ============================================================

# ── VPS ──────────────────────────────────────────────────────
VPS_IP=your.vps.ip.address

# ── PostgreSQL + pgvector ─────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=grants_db
POSTGRES_USER=grants_user
POSTGRES_PASSWORD=your_strong_password_here

# ── FastAPI Backend ───────────────────────────────────────────
SECRET_KEY=generate-a-random-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Admin Seed User ───────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here

# ── Telegram Bot ──────────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Your Telegram chat ID (message @userinfobot)
TELEGRAM_CHAT_ID=
# Comma-separated Telegram user IDs allowed to use the bot
TELEGRAM_ALLOWED_USERS=123456789,987654321

# ── NVIDIA AI API ─────────────────────────────────────────────
# Get from: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=qwen/qwen3-coder-480b-a35b-instruct
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
# Optional: dedicated key for embeddings. Falls back to NVIDIA_API_KEY when empty.
NVIDIA_EMBEDDING_API_KEY=

# ── OpenAI API (Fallback) ─────────────────────────────────────
OPENAI_API_KEY=sk-proj-your-key-here

# ── Tavily Search API ─────────────────────────────────────────
# Get from: https://app.tavily.com
TAVILY_API_KEY=tvly-your-key-here

# ── Firecrawl API ─────────────────────────────────────────────
# Get from: https://www.firecrawl.dev
FIRECRAWL_API_KEY=fc-your-key-here

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── n8n Workflow Automation ───────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=your_n8n_password_here

# ── Backend URL ───────────────────────────────────────────────
BACKEND_URL=http://backend:8000

# ── CORS Origins ──────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app

# ── Frontend (set in Vercel dashboard) ───────────────────────
NEXT_PUBLIC_API_URL=http://your.vps.ip/api
