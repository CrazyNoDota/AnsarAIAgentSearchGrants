# ============================================================
# AI Grant Agent — Environment Variables
# Copy this file to .env (local dev) and set the same vars in
# Vercel project settings for production.
# ============================================================

# ── Local docker-compose dev only ────────────────────────────
# These are ignored when DATABASE_URL is set.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=grants_db
POSTGRES_USER=grants_user
POSTGRES_PASSWORD=changeme_db_password

# Set to 1 in docker-compose to enable APScheduler in-process.
# Always 0 (or unset) on Vercel — Vercel Cron handles scheduling.
RUN_SCHEDULER=0

# ── Production / Supabase ────────────────────────────────────
# Pooler URL (port 6543, ?pgbouncer=true) — used by FastAPI/runtime queries.
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct URL (port 5432) — used only by Alembic for migrations.
DIRECT_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres

# ── Backend ──────────────────────────────────────────────────
SECRET_KEY=generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Allowed CORS origins, comma-separated.
# Add your frontend Vercel URL(s) here.
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# ── Telegram ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER
TELEGRAM_CHAT_ID=YOUR_CHAT_ID
TELEGRAM_ALLOWED_USERS=YOUR_USER_ID,SECOND_USER_ID

# Random shared secret. Telegram sends it as a header on every webhook
# call so we can verify the request is authentic.
TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-string

# ── AI providers ─────────────────────────────────────────────
OPENAI_API_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=qwen/qwen3-coder-480b-a35b-instruct

# ── Internal URLs ────────────────────────────────────────────
# When the bot webhook function calls the backend on Vercel, both run on
# the same project, so set this to the project's public URL.
BACKEND_URL=https://your-api-project.vercel.app

# ── Vercel Cron ──────────────────────────────────────────────
# Vercel sends `Authorization: Bearer <CRON_SECRET>` to cron endpoints
# automatically when this env var is defined.
CRON_SECRET=generate-a-long-random-string
